# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,85,81)
  Font = Font["11"]
  Text = ("MiConvertImage")
  Icon = Picture["miconvertimage.png"]
  Resizable = False
  { Menu1 Menu
    Text = ("About")
    { mnuApoie Menu
      Text = ("Support MiConvertImage")
    }
    { Menu3 Menu
    }
    { mnuSobre Menu
      Text = ("About MiConvertImage")
    }
  }
  { Menu2 Menu
    Text = ("Menu2")
    Visible = False
    { mnuCopiar Menu
      Text = ("Copiar")
    }
  }
  { btnConvert Button
    MoveScaled(1,34,23,4)
    Font = Font["12"]
    Text = ("Convert")
  }
  { lstInfo ColumnView
    MoveScaled(1,45,82,31)
    PopupMenu = "Menu2"
    Resizable = True
  }
  { lstArquivos ListView
    MoveScaled(1,6,82,16)
    Mode = Select.Multiple
    ShowCheck = True
  }
  { btnAddFiles Button
    MoveScaled(1,1,25,4)
    Font = Font["12"]
    Text = ("Add Files")
  }
  { btnRemoverItens Button
    MoveScaled(27,1,25,4)
    Font = Font["12"]
    Text = ("Remove")
  }
  { Label2 Label
    MoveScaled(1,22,23,5)
    Font = Font["Bold,12"]
    Text = ("Convert to")
  }
  { cboConvertType ComboBox
    MoveScaled(1,27,23,5)
    #Translate = False
    ReadOnly = True
    List = ["WEBP", "PNG", "JPG", "ICO", "SVG", "PDF", "Base64"]
    Text = "WEBP"
  }
  { lblInfo Label
    MoveScaled(1,41,81,3)
    Font = Font["Bold,12"]
  }
  { btnRemoverTodosItens Button
    MoveScaled(53,1,25,4)
    Font = Font["12"]
    Text = ("Remove All")
  }
  { Label1 Label
    MoveScaled(25,22,23,5)
    Font = Font["Bold,12"]
    Text = ("Quality (%)")
  }
  { Label3 Label
    MoveScaled(49,22,23,5)
    Font = Font["Bold,12"]
    Text = ("Size (WxH)")
  }
  { txtQualidade ValueBox
    MoveScaled(25,27,23,5)
    #Translate = False
    Text = "90"
  }
  { txtWidth ValueBox
    MoveScaled(49,27,10,5)
    #Translate = False
  }
  { txtHeight ValueBox
    MoveScaled(62,27,10,5)
    #Translate = False
  }
  { Label4 Label
    MoveScaled(60,28,3,4)
    #Translate = False
    Text = "x"
  }
  { chkAjusteAutomatico CheckBox
    MoveScaled(73,28,4,4)
    #Translate = False
    Text = " "
    Value = CheckBox.True
  }
}
